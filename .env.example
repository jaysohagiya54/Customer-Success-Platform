# ---- Database ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=csp

# ---- Auth ----
# Generate a strong value: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=please-change-this-in-production-min-32-chars

# Bootstrap admin account (created on first startup)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123!

# ---- AI ----
# Leave blank to use the deterministic heuristic fallback (no external calls).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Networking ----
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
